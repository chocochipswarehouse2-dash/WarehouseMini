# =============================================================================
# WMS CHOCOCHIPS — Environment Variables Template
# =============================================================================
# Salin file ini menjadi .env (tanpa .example) dan isi nilainya.
# File .env TIDAK BOLEH di-commit ke GitHub (sudah ada di .gitignore).
# =============================================================================

# ─── Supabase (Wajib untuk app) ───────────────────────────────────────────────
# Project URL dari Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://xxx.supabase.co

# Anon/Public Key dari Supabase Dashboard > Settings > API
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ─── Untuk test-webhook.ts (tidak perlu di-deploy, hanya lokal) ───────────────
# Service Role Key dari Supabase Dashboard > Settings > API > service_role
# JANGAN SHARE key ini — bypass semua RLS!
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...service_role_key_here...

# GAS Web App URL (untuk test end-to-end webhook)
# Didapat dari GAS Editor > Deploy > Manage Deployments > Web App URL
GAS_API_URL=https://script.google.com/macros/s/XXXXXXXXXX/exec

# ─── Build Config (opsional) ──────────────────────────────────────────────────
VITE_BASE=